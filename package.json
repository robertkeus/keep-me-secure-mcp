{
  "name": "keep-me-secure-mcp",
  "version": "1.7.0",
  "description": "MCP server that tells your coding agent whether your installed packages need patching",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "build:plugin": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --minify --outfile=plugin/server.mjs --banner:js=\"import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\"",
    "build:site": "node scripts/build-site.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "smol-toml": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2",
    "wrangler": "4.157.0"
  }
}
